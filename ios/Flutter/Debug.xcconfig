#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Google Drive callback for Debug. Runner/Info.plist consumes this setting;
// Release and Profile use Release.xcconfig. Keep it aligned with
// GoogleDriveClientConfig.debugClientId. This registers the native callback
// only; the Google client must separately be valid for the shipping platform.
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.438894533578-i9ecrp6g518tdenpq5fo4dkv90ce2rig
